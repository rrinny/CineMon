<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 포커스(입력완료 예시처럼 주황 테두리) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gc_black_10" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/gc_orange_main" />
        </shape>
    </item>

    <!-- 기본(회색 테두리) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gc_black_10" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/gc_black_40" />
        </shape>
    </item>
</selector>
