<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/presetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ✅ 상단 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="62dp"
            android:src="@drawable/icon_left"
            android:tint="@color/gc_black_70"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="프리셋 설정"
            android:textSize="18sp"
            android:textColor="@color/gc_black_90"
            android:fontFamily="@font/suite_medium"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivBack"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 스크롤 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svPreset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/presetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="36dp">

            <!-- 저장된 프리셋 -->
            <TextView
                android:id="@+id/tvSavedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장된 프리셋"
                android:textSize="20sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_extrabold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- 포지션 -->
            <TextView
                android:id="@+id/tvSavedPosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="포지션"
                android:textSize="18sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_semibold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSavedTitle"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSavedPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="10dp"
                app:singleLine="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSavedPosLabel">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSavedPosStore"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="매점"
                    android:textColor="@color/gc_black_70"
                    android:textSize="14sp"
                    android:fontFamily="@font/suite_medium"
                    android:checkable="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="26dp"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/gc_orange_main"
                    app:chipBackgroundColor="@color/gc_orange_main_20"
                    app:chipStartPadding="18dp"
                    app:chipEndPadding="12dp"
                    app:closeIconVisible="true"
                    app:closeIcon="@drawable/ic_bs_close_8"
                    app:closeIconTint="@color/gc_black_50"
                    app:closeIconSize="8dp"
                    app:closeIconStartPadding="8dp"
                    app:closeIconEndPadding="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSavedPosTicket"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="검표"
                    android:textColor="@color/gc_black_70"
                    android:textSize="14sp"
                    android:fontFamily="@font/suite_medium"
                    android:checkable="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="26dp"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/gc_green_sub"
                    app:chipBackgroundColor="#3306AF00"
                    app:chipStartPadding="18dp"
                    app:chipEndPadding="12dp"
                    app:closeIconVisible="true"
                    app:closeIcon="@drawable/ic_bs_close_8"
                    app:closeIconTint="@color/gc_black_50"
                    app:closeIconSize="8dp"
                    app:closeIconStartPadding="8dp"
                    app:closeIconEndPadding="0dp"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- 근무 타입 -->
            <TextView
                android:id="@+id/tvSavedWorkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="근무 타입"
                android:textSize="18sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_semibold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupSavedPosition"/>

            <HorizontalScrollView
                android:id="@+id/hsWorkType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSavedWorkLabel">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSavedWorkType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="10dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSavedTypeOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="오픈 07:00~11:30"
                        android:textColor="@color/gc_black_70"
                        android:textSize="14sp"
                        android:fontFamily="@font/suite_medium"
                        android:checkable="false"
                        app:ensureMinTouchTargetSize="false"
                        app:chipMinHeight="26dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/gc_orange_main"
                        app:chipBackgroundColor="@color/gc_orange_main_20"
                        app:chipStartPadding="18dp"
                        app:chipEndPadding="12dp"
                        app:closeIconVisible="true"
                        app:closeIcon="@drawable/ic_bs_close_8"
                        app:closeIconTint="@color/gc_black_50"
                        app:closeIconSize="8dp"
                        app:closeIconStartPadding="8dp"
                        app:closeIconEndPadding="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSavedTypeMiddle"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="미들 11:30~18:30"
                        android:textColor="@color/gc_black_70"
                        android:textSize="14sp"
                        android:fontFamily="@font/suite_medium"
                        android:checkable="false"
                        app:ensureMinTouchTargetSize="false"
                        app:chipMinHeight="26dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/gc_green_sub"
                        app:chipBackgroundColor="#3306AF00"
                        app:chipStartPadding="18dp"
                        app:chipEndPadding="12dp"
                        app:closeIconVisible="true"
                        app:closeIcon="@drawable/ic_bs_close_8"
                        app:closeIconTint="@color/gc_black_50"
                        app:closeIconSize="8dp"
                        app:closeIconStartPadding="8dp"
                        app:closeIconEndPadding="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSavedTypeClose"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="마감 18:30~00:00"
                        android:textColor="@color/gc_black_70"
                        android:textSize="14sp"
                        android:fontFamily="@font/suite_medium"
                        android:checkable="false"
                        app:ensureMinTouchTargetSize="false"
                        app:chipMinHeight="26dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/gc_blue_public"
                        app:chipBackgroundColor="@color/gc_blue_public_20"
                        app:chipStartPadding="18dp"
                        app:chipEndPadding="12dp"
                        app:closeIconVisible="true"
                        app:closeIcon="@drawable/ic_bs_close_8"
                        app:closeIconTint="@color/gc_black_50"
                        app:closeIconSize="8dp"
                        app:closeIconStartPadding="8dp"
                        app:closeIconEndPadding="0dp"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 프리셋 추가 -->
            <TextView
                android:id="@+id/tvAddTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프리셋 추가"
                android:textSize="20sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_extrabold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="34dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hsWorkType"/>

            <!-- 추가: 포지션 -->
            <TextView
                android:id="@+id/tvAddPosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="포지션"
                android:textSize="18sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_semibold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAddTitle"/>

            <!-- ✅ 기본 테두리 회색 + 아이콘과 간격(붙지 않게) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddPosition"
                android:layout_width="0dp"
                android:layout_height="53dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gc_black_40"
                app:cardBackgroundColor="@color/gc_black_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivAddPosition"
                app:layout_constraintTop_toBottomOf="@id/tvAddPosLabel">

                <EditText
                    android:id="@+id/etAddPosition"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical"
                    android:text=""
                    android:hint=""
                    android:textSize="16sp"
                    android:textColor="@color/gc_black_90"
                    android:fontFamily="@font/suite_medium"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/ivAddPosition"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="22dp"
                android:src="@drawable/icon_add"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/cardAddPosition"
                app:layout_constraintBottom_toBottomOf="@id/cardAddPosition"/>

            <!-- 추가: 근무 타입 -->
            <TextView
                android:id="@+id/tvAddWorkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="근무 타입"
                android:textSize="18sp"
                android:textColor="@color/gc_black_70"
                android:fontFamily="@font/suite_semibold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAddPosition"/>

            <!-- 기본 테두리 회색 + 아이콘과 간격(붙지 않게) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddWorkType"
                android:layout_width="0dp"
                android:layout_height="53dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gc_black_40"
                app:cardBackgroundColor="@color/gc_black_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivAddWorkType"
                app:layout_constraintTop_toBottomOf="@id/tvAddWorkLabel">

                <EditText
                    android:id="@+id/etAddWorkType"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical"
                    android:text=""
                    android:hint=""
                    android:textSize="16sp"
                    android:textColor="@color/gc_black_90"
                    android:fontFamily="@font/suite_medium"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/ivAddWorkType"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="22dp"
                android:src="@drawable/icon_add"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/cardAddWorkType"
                app:layout_constraintBottom_toBottomOf="@id/cardAddWorkType"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
