        android:id="@+id/cardUpcoming"
        android:layout_width="341dp"
        android:layout_height="wrap_content"
        android:minHeight="220dp"
        android:background="@drawable/bg_home_card"
        android:orientation="vertical"
        android:padding="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeSheet"
        android:layout_marginStart="26dp"
        android:layout_marginTop="241dp">

        <TextView
            android:id="@+id/tvUpcomingDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1월 18일 일요일"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_extrabold"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="포지션"
                    android:textColor="@color/gc_black_70"
                    android:textSize="16sp"
                    android:fontFamily="@font/suite_extrabold"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/chipPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_orange"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="매점"
                    android:textColor="@color/gc_black_70"
                    android:textSize="14sp"
                    android:fontFamily="@font/suite_medium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="근무 타입"
                    android:textColor="@color/gc_black_70"
                    android:textSize="16sp"
                    android:fontFamily="@font/suite_extrabold"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/chipWorkType"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_blue"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="마감 18:30~00:00"
                    android:textColor="@color/gc_black_70"
                    android:textSize="14sp"
                    android:fontFamily="@font/suite_medium"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="메모"
            android:textColor="@color/gc_black_70"
            android:textSize="16sp"
            android:fontFamily="@font/suite_extrabold"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="마감 때 잊지 않고 팝콘 기기 잘 끄기!"
            android:textColor="@color/gc_black_70"
            android:textSize="14sp"
            android:fontFamily="@font/suite_medium"
            android:lineSpacingExtra="4sp"/>

    </LinearLayout>

    <!-- 하단 네비 -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="89dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

