<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 상단: 월 이동 영역 -->
    <ImageView
        android:id="@+id/btnPrevMonth"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_left"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="100dp"
        android:layout_marginTop="60dp" />

    <TextView
        android:id="@+id/tvMonthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026년 1월"
        android:textColor="@color/gc_black_70"
        android:textSize="18sp"
        android:fontFamily="@font/suite_extrabold"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnPrevMonth"
        app:layout_constraintBottom_toBottomOf="@id/btnPrevMonth"
        app:layout_constraintStart_toEndOf="@id/btnPrevMonth"
        app:layout_constraintEnd_toStartOf="@id/btnNextMonth" />

    <ImageView
        android:id="@+id/btnNextMonth"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_right"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnPrevMonth"
        android:layout_marginEnd="100dp" />

    <!-- 요일 줄 -->
    <LinearLayout
        android:id="@+id/rowWeekdays"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPrevMonth"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="일"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="월"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="화"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="수"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="목"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="금"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="토"
            android:gravity="center"
            android:textColor="@color/gc_black_70"
            android:textSize="18sp"
            android:fontFamily="@font/suite_semibold"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 달력 그리드 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowWeekdays"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="110dp" />

    <!-- 우하단 플로팅 추가 버튼 -->
    <ImageButton
        android:id="@+id/btnAddWork"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/f_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="18dp" />

    <!-- 하단 네비 include -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="89dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
