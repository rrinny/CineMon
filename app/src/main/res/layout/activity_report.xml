<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 하단 네비 include -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="89dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svReport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/reportContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- 헤더(연노랑 배경) 영역 -->
            <FrameLayout
                android:id="@+id/reportHeader"
                android:layout_width="0dp"
                android:layout_height="236dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivReportHeaderBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_report_head"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvHeaderLine1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="박채린 님의"
                        android:textColor="#444444"
                        android:textSize="20sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="58dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHeaderLine2Left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이번 달"
                        android:textColor="#444444"
                        android:textSize="20sp"
                        android:fontFamily="@font/suite_semibold"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeaderLine1" />

                    <TextView
                        android:id="@+id/tvHeaderLine2Right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 예상 급여"
                        android:textColor="#FE6301"
                        android:textSize="20sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/tvHeaderLine2Left"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvHeaderLine2Left" />

                    <TextView
                        android:id="@+id/tvHeaderYm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026. 1"
                        android:textColor="#444444"
                        android:textSize="18sp"
                        android:fontFamily="@font/suite_semibold"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="26dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeaderLine2Left" />

                    <TextView
                        android:id="@+id/tvHeaderMoney"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="480,000"
                        android:textColor="#FE6301"
                        android:textSize="20sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeaderYm" />

                    <TextView
                        android:id="@+id/tvHeaderMoneySuffix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="원이에요!"
                        android:textColor="#444444"
                        android:textSize="20sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/tvHeaderMoney"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvHeaderMoney" />

                    <ImageView
                        android:id="@+id/ivPopcorn"
                        android:layout_width="114dp"
                        android:layout_height="114dp"
                        android:layout_marginEnd="24dp"
                        android:layout_marginTop="78dp"
                        android:src="@drawable/cinemon_charc"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCheer"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginEnd="124dp"
                        android:layout_marginTop="88dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/gc_orange_main"
                        app:cardCornerRadius="10dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvCheer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:gravity="center"
                            android:text="고생했어!"
                            android:textColor="#FFFCF3"
                            android:textSize="11sp"
                            android:fontFamily="@font/suite_bold" />
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- 드롭다운 토글 행 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rowInvoiceToggle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/reportHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivInvoiceDoc"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/item_invoice"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvInvoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상세 인보이스 확인하기"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:fontFamily="@font/suite_semibold"
                    android:layout_marginStart="14dp"
                    app:layout_constraintStart_toEndOf="@id/ivInvoiceDoc"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivInvoiceArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_down"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 펼쳐지는 인보이스 카드(기본 숨김) -->

            <LinearLayout
                android:id="@+id/cardInvoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_invoice_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/rowInvoiceToggle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="4dp"
                        android:text="기본 급여:"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBasePay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="394,000 원"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:text="주휴 수당:"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklyPay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="60,000 원"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:text="공휴일 수당:"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHolidayPay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="14,000 원"
                        android:textColor="#0073FF"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:text="야간 수당:"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_extrabold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNightPay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="12,000 원"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:fontFamily="@font/suite_semibold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 지난 급여 타이틀/필터 -->

            <TextView
                android:id="@+id/tvPastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지난 급여"
                android:textColor="#444444"
                android:textSize="20sp"
                android:fontFamily="@font/suite_extrabold"
                android:textStyle="bold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/cardInvoice"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="22dp"
                android:src="@drawable/icon_filter"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvPastTitle"
                app:layout_constraintBottom_toBottomOf="@id/tvPastTitle" />

            <!--지난 급여 리스트-->
            <LinearLayout
                android:id="@+id/pastList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvPastTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvYear1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FE6301"
                    android:textSize="16sp"
                    android:fontFamily="@font/suite_extrabold"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPast12"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D6D6D6"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPastIcon12"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/item_invoice"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMonth12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12월"
                            android:textColor="#444444"
                            android:textSize="20sp"
                            android:fontFamily="@font/suite_extrabold"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/ivPastIcon12"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMoney12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="450,000원"
                            android:textColor="#444444"
                            android:textSize="18sp"
                            android:fontFamily="@font/suite_medium"
                            android:layout_marginEnd="14dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvYear2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FE6301"
                    android:textSize="16sp"
                    android:fontFamily="@font/suite_extrabold"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPast11"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D6D6D6"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPastIcon11"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/item_invoice"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMonth11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="11월"
                            android:textColor="#444444"
                            android:textSize="20sp"
                            android:fontFamily="@font/suite_extrabold"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/ivPastIcon11"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMoney11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="500,000원"
                            android:textColor="#444444"
                            android:textSize="18sp"
                            android:fontFamily="@font/suite_medium"
                            android:layout_marginEnd="14dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvYear3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#FE6301"
                    android:textSize="16sp"
                    android:fontFamily="@font/suite_extrabold"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPast10"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D6D6D6"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPastIcon10"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/item_invoice"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMonth10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10월"
                            android:textColor="#444444"
                            android:textSize="20sp"
                            android:fontFamily="@font/suite_extrabold"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/ivPastIcon10"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvMoney10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="510,000원"
                            android:textColor="#444444"
                            android:textSize="18sp"
                            android:fontFamily="@font/suite_medium"
                            android:layout_marginEnd="14dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
