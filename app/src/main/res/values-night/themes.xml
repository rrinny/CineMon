<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GCinemon" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand (same) -->
        <item name="colorPrimary">@color/gc_orange_main</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSecondary">@color/gc_blue_public</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="colorTertiary">@color/gc_green_sub</item>
        <item name="colorOnTertiary">@android:color/white</item>

        <!-- Dark surfaces -->
        <item name="android:colorBackground">@color/gc_black_90</item>
        <item name="colorOnBackground">@color/gc_black_10</item>
        <item name="colorSurface">@color/gc_black_90</item>
        <item name="colorOnSurface">@color/gc_black_10</item>

        <!-- Default font -->
        <item name="fontFamily">@font/suite_medium</item>
        <item name="android:fontFamily">@font/suite_medium</item>

        <!-- Status bar (dark) -->
        <item name="android:statusBarColor">@color/gc_black_90</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
